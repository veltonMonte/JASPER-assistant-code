# JASPER AI Personal Assistant - Configurações de Ambiente

# Configurações do Servidor
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# Inteligência Artificial - Google Gemini & Gemini Live API
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.5-flash
GEMINI_LIVE_MODEL=gemini-3.8-live
# Modelos alternativos: gemini-3.8-live-extended-thinking, gemini-2.5-flash-native-audio-latest
# Vozes disponíveis: Charon (grave/confiante), Fenrir (firme), Puck (claro), Kore, Aoede, Leda, Orus, Zephyr
GEMINI_VOICE=Charon

# Controle de Voz & Serviços Cloud (Opcionais / Fallbacks)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN
TELEGRAM_DEFAULT_CHAT_ID=YOUR_TELEGRAM_CHAT_ID

# Dispositivos da Rede Local (PC do Usuário para Wake-on-LAN)
TARGET_PC_MAC=00:11:22:33:44:55
TARGET_PC_IP=192.168.1.100
TARGET_PC_PORT=9

# Banco de Dados SQLite
DATABASE_PATH=./jasper.db

# Configuração de Segurança Local
API_SECRET_TOKEN=jasper-secure-local-token
DESKTOP_MAC_ADDRESS="00:00:00:00:00:00"
